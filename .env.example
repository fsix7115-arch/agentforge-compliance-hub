# --- Database ---
# Local dev (default, zero setup):
DATABASE_URL="file:./dev.db"
# Production / docker compose (Postgres):
# DATABASE_URL="postgresql://agentforge:agentforge@localhost:5432/agentforge?schema=public"

# --- Auth ---
# openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# --- Optional AI (AI-suggested policies) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional notifications ---
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM="alerts@agentforge.dev"

# --- Optional background workers ---
# When unset, aggregation runs inline via `npm run jobs:aggregate`.
REDIS_URL=

